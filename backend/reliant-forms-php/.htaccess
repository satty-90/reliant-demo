# Reliant forms endpoint: never list folders, never show these internals.
Options -Indexes
<FilesMatch "^(purge\.php|retry\.php|forms-lib\.php|\.user\.ini)$">
    Require all denied
</FilesMatch>

# These URLs only return JSON or file downloads: never allow them to run scripts or be framed.
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
</IfModule>
