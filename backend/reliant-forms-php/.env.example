# --- Email provider ---
EMAIL_PROVIDER=postmark
POSTMARK_TOKEN=
POSTMARK_STREAM=outbound
MAIL_FROM=website@notify.reliantindustries.com
MAIL_FROM_CONFIRM=quotes@notify.reliantindustries.com
FORMS_SENDER_NAME=Reliant Website

# --- Who gets what ---
FORMS_MAIL_TO_RFQ=leads@reliantindustries.com
FORMS_MAIL_TO_CONTACT=sales@reliantindustries.com
FORMS_MAIL_TO_CAREERS=
RFQ_CONFIRMATION=1
RFQ_CONFIRM_REPLY_TO=leads@reliantindustries.com
COMPANY_PHONE=586-275-0479
# Fill in only once Reliant agrees a promise, e.g. "1 business day". Leave empty to promise nothing.
RFQ_RESPONSE_TIME=

# --- Site and storage ---
FORMS_ALLOWED_ORIGINS=https://www.reliantindustries.com,https://satty-90.github.io
FORMS_PUBLIC_URL=https://www.reliantindustries.com/forms
FORMS_STORAGE_DIR=/home/USER/storage/reliant-forms
FORMS_LINK_SECRET=
# TURNSTILE_SECRET=

# --- Abuse limits (defaults shown) ---
# FORMS_LIMIT_EMAIL_10MIN=3      messages per email address per 10 minutes
# FORMS_LIMIT_EMAIL_DAY=10       messages per email address per day
# FORMS_LIMIT_ALL_10MIN=40       whole site, per 10 minutes
# FORMS_LIMIT_ALL_DAY=300        whole site, per day (a spread-out spam attack cannot exceed this)

# --- Retention (purge.php, run daily) ---
# FORMS_KEEP_FILES_DAYS=180      uploaded drawings and resumes. Reliant to confirm.
# FORMS_KEEP_LEADS_DAYS=730      saved lead records

# --- Optional virus scan: only if the host has ClamAV (ask GoDaddy / Techie Gurus) ---
# CLAMSCAN_PATH=/usr/bin/clamscan
